rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    match /tickets/{ticketId} {
      // Allow an unauthenticated user to submit a survey rating.
      // They can only write to the 'rating' and 'fecha_calificacion' fields.
      // They cannot change any other field.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'fecha_calificacion'])
                      && request.resource.data.rating is number
                      && request.resource.data.rating >= 1 && request.resource.data.rating <= 3
                      && request.resource.data.fecha_calificacion is string;
    }
    
    // Allow authenticated users to read and write to all documents.
    // This rule will also apply to /tickets/{ticketId} for authenticated users,
    // allowing them to perform other operations like create, read, and full updates.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
